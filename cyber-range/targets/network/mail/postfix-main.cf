# =============================================================================
# Postfix — Deliberately Insecure Configuration
# =============================================================================
# DMZ-23: Open relay — accepts mail from anyone to anyone
# DMZ-24: VRFY enabled — user enumeration
# DMZ-25: EXPN enabled — mailing list enumeration
# DMZ-26: No TLS required — cleartext auth
# DMZ-30: Permissive command handling

# Basic settings
myhostname = mail.psyche.local
mydomain = psyche.local
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4

# DMZ-23: Open relay — no restrictions
mynetworks = 0.0.0.0/0
relay_domains = *
smtpd_relay_restrictions = permit

# DMZ-24, DMZ-25: Enable VRFY and EXPN
disable_vrfy_command = no

# DMZ-26: No TLS (cleartext auth)
smtpd_use_tls = no
smtpd_tls_auth_only = no

# DMZ-29: No SPF/DKIM/DMARC configured (intentional omission)

# DMZ-30: Permissive recipient handling
smtpd_recipient_restrictions = permit

# Mailbox config
home_mailbox = Maildir/
mailbox_size_limit = 0
message_size_limit = 10240000
